# ─────────────────────────────────────────────
# FinFlow — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=finflow

# Express server DATABASE_URL (for running locally without Docker)
# DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/finflow

# JWT
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=production

# URLs
CLIENT_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Nodemailer (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=FinFlow <your-gmail@gmail.com>

# AWS S3 (for file uploads - avatars and receipts)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=finflow-uploads-ananya-tf