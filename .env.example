# ─────────────────────────────────────────────
# FinFlow — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL (used by Docker Compose to spin up the DB container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=finflow

# Express server DATABASE_URL (auto-built by docker-compose using above values)
# For Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password@postgres:5432/finflow

# JWT
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=production

# URLs
CLIENT_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Nodemailer (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=FinFlow <your-gmail@gmail.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
