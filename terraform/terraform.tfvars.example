# ──────────────────────────────────────────────────────────
# Terraform Variables Example
# Copy this file to terraform.tfvars and update with your values
# ──────────────────────────────────────────────────────────

# General Configuration
project_name = "finflow"
environment  = "prod"
aws_region   = "ap-south-1"

# S3 Configuration
s3_bucket_name = "finflow-uploads-ananya-2026"

# S3 Features
enable_versioning = true
enable_encryption = true

# Lifecycle Rules (Optional - set to true to enable cleanup)
lifecycle_rules_enabled    = false
lifecycle_transition_days  = 90   # Transition to Glacier after 90 days
lifecycle_expiration_days  = 0    # Set to 365+ for automatic deletion, 0 = disabled

# CORS Configuration
allowed_origins = [
  "http://localhost:3001",
  "http://localhost:3000",
  # Add your production URLs here:
  # "https://your-app.com",
  # "https://www.your-app.com"
]

# IAM Configuration
iam_user_name   = "finflow-app-user"
create_iam_user = false # Set to false since user already exists

# GitHub OIDC (Future enhancement - replace long-lived credentials)
enable_github_oidc = false
github_org         = "AnanyaRaj14"
github_repo        = "finflow"
